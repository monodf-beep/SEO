generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  googleTokens  Json?     // Encrypted GSC OAuth tokens
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  sites         Site[]
  alerts        Alert[]
  apiKeys       ApiKey[]
  objectives    Objective[]
  googleAccounts GoogleAccount[]
}

// A Google identity linked to a CrawlSEO user. The login account is one of
// them; further accounts are linked from the settings page so that sites
// owned by several Google accounts live in one workspace. Tokens have the
// same shape as User.googleTokens.
model GoogleAccount {
  id        String   @id @default(cuid())
  userId    String
  email     String
  name      String?
  picture   String?
  tokens    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sites     Site[]

  @@unique([userId, email])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ API KEYS (BYOK) ============

model ApiKey {
  id                String   @id @default(cuid())
  userId            String
  provider          String   // "dataforseo"
  encryptedLogin    String
  encryptedPassword String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// ============ SITES ============

model Site {
  id          String   @id @default(cuid())
  userId      String
  domain      String   // e.g. "brandson.digital"
  gscProperty String?  // e.g. "sc-domain:brandson.digital"
  googleAccountId String? // which linked Google account reads Search Console; null = the login account
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleAccount GoogleAccount?  @relation(fields: [googleAccountId], references: [id], onDelete: SetNull)
  keywords      Keyword[]
  pages         Page[]
  crawls        Crawl[]
  vitals        VitalsReport[]
  alerts        Alert[]
  savedKeywords SavedKeyword[]
  rankSnapshots RankSnapshot[]
  objectiveActions ObjectiveAction[]

  @@unique([userId, domain])
}

// ============ GSC DATA ============

model Keyword {
  id          String   @id @default(cuid())
  siteId      String
  query       String   // The search query
  date        DateTime // Date of the data point
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  page        String?  // Landing page URL
  device      String?  // DESKTOP, MOBILE, TABLET
  country     String?  // Country code

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query, date])
  @@index([siteId, date])
  @@index([siteId, query, date])
}

model Page {
  id          String   @id @default(cuid())
  siteId      String
  url         String
  date        DateTime
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, url, date])
  @@index([siteId, date])
  @@index([siteId, url, date])
}

// ============ SAVED KEYWORDS ============

model SavedKeyword {
  id        String   @id @default(cuid())
  siteId    String
  query     String
  notes     String?
  createdAt DateTime @default(now())

  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query])
  @@index([siteId])
}

// ============ RANK TRACKING ============

model RankSnapshot {
  id          String   @id @default(cuid())
  siteId      String
  query       String
  position    Float
  clicks      Int      @default(0)
  impressions Int      @default(0)
  page        String?
  date        DateTime

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query, date])
  @@index([siteId, date])
  @@index([siteId, query, date])
}

// ============ CRAWLER ============

model Crawl {
  id          String      @id @default(cuid())
  siteId      String
  status      CrawlStatus @default(PENDING)
  startedAt   DateTime?
  finishedAt  DateTime?
  pagesFound  Int         @default(0)
  issuesFound Int         @default(0)
  healthScore Int?        // 0-100
  maxPages    Int         @default(200)

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  issues      CrawlIssue[]
  auditPages  AuditPage[]
  auditLinks  AuditLink[]

  @@index([siteId, startedAt])
}

enum CrawlStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ============ AUDIT PAGE DATA ============

model AuditPage {
  id              String  @id @default(cuid())
  crawlId         String
  url             String
  statusCode      Int
  redirectUrl     String?

  title           String?
  description     String?
  canonical       String?
  robotsMeta      String?

  h1Count         Int     @default(0)
  h1s             Json?   // Array of H1 text
  wordCount       Int     @default(0)

  imageCount      Int     @default(0)
  imagesMissingAlt Int    @default(0)

  internalLinks   Int     @default(0)
  externalLinks   Int     @default(0)

  hasSchema       Boolean @default(false)
  hreflangTags    Json?   // Array of hreflang values

  contentScore    Int     @default(0)  // 0-100
  contentHash     String? // SHA-256 of body text

  responseTimeMs  Int     @default(0)
  byteSize        Int     @default(0)
  indexable       Boolean @default(true)

  crawl           Crawl   @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId])
  @@index([crawlId, url])
}

// ============ AUDIT LINK GRAPH ============

model AuditLink {
  id          String  @id @default(cuid())
  crawlId     String
  sourceUrl   String
  targetUrl   String
  anchorText  String?
  isInternal  Boolean @default(true)
  isNofollow  Boolean @default(false)
  statusCode  Int?

  crawl       Crawl   @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId])
  @@index([crawlId, sourceUrl])
}

model CrawlIssue {
  id          String        @id @default(cuid())
  crawlId     String
  url         String
  type        IssueType
  severity    IssueSeverity
  message     String
  details     Json?         // Additional context

  crawl       Crawl         @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId, type])
}

enum IssueType {
  BROKEN_LINK           // 404, 500, etc.
  REDIRECT              // 301, 302 chains
  MISSING_TITLE         // No <title> tag
  MISSING_DESCRIPTION   // No meta description
  DUPLICATE_TITLE       // Same title on multiple pages
  DUPLICATE_DESCRIPTION // Same description on multiple pages
  MISSING_H1            // No H1 heading
  MULTIPLE_H1           // More than one H1
  MISSING_ALT           // Images without alt text
  MISSING_CANONICAL     // No canonical tag
  MISSING_ROBOTS        // No robots.txt
  MISSING_SITEMAP       // No sitemap.xml
  MISSING_SCHEMA        // No structured data
  SLOW_PAGE             // Load time > 3s
  MIXED_CONTENT         // HTTP resources on HTTPS page
  LARGE_PAGE            // Page size > 3MB
}

enum IssueSeverity {
  CRITICAL
  WARNING
  INFO
}

// ============ CORE WEB VITALS ============

model VitalsReport {
  id          String   @id @default(cuid())
  siteId      String
  url         String
  date        DateTime @default(now())
  device      String   // MOBILE or DESKTOP

  // Core Web Vitals
  lcp         Float?   // Largest Contentful Paint (seconds)
  fid         Float?   // First Input Delay (milliseconds)
  cls         Float?   // Cumulative Layout Shift (score)
  inp         Float?   // Interaction to Next Paint (milliseconds)

  // Performance
  perfScore   Int?     // 0-100 Lighthouse performance score
  speedIndex  Float?   // Speed Index (seconds)
  ttfb        Float?   // Time to First Byte (seconds)

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, date])
  @@index([siteId, url, date])
}

// ============ ALERTS ============

model Alert {
  id          String     @id @default(cuid())
  userId      String
  siteId      String
  type        AlertType
  channel     AlertChannel
  config      Json       // Thresholds, webhook URL, etc.
  enabled     Boolean    @default(true)
  lastFired   DateTime?
  createdAt   DateTime   @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

enum AlertType {
  TRAFFIC_DROP       // Clicks dropped > X%
  POSITION_CHANGE    // Keyword position changed > X
  NEW_404            // New broken links detected
  VITALS_DEGRADED    // Core Web Vitals got worse
  CRAWL_ISSUES       // New crawl issues detected
}

enum AlertChannel {
  EMAIL
  TELEGRAM
  WEBHOOK
  SLACK
}

// ============ OBJECTIVES ============
//
// An objective is a goal that spans sites ("grow the visibility of the
// Savoyard language"). It carries a scope — which sites, which search terms
// to defend and which competing terms to capture — and the platform derives a
// KPI (share of demand) and a list of actions from the GSC and crawl data it
// already holds. Objectives nest one level or more through parentId.

model Objective {
  id          String          @id @default(cuid())
  userId      String
  parentId    String?
  title       String
  description String?
  siteIds     String[]        @default([])  // empty = every site of the user
  focusTerms  String[]        @default([])  // terms to defend, substring match on queries
  rivalTerms  String[]        @default([])  // competing terms to capture
  entityName  String?                       // the organisation behind the goal, for Wikipedia / Wikidata / profiles
  wikiArticles String[]       @default([])  // fr.wikipedia titles to watch
  mediaBlogs  String[]        @default([])  // media with a contributor space the user can publish in
  guestSites  String[]        @default([])  // sites where the user can publish articles themselves
  socialProfiles String[]     @default([])  // public profile URLs (YouTube, Facebook, Instagram, LinkedIn…)
  targetShare Float?                        // target share of demand, 0..1
  deadline    DateTime?
  status      ObjectiveStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Objective?      @relation("ObjectiveTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Objective[]     @relation("ObjectiveTree")
  actions     ObjectiveAction[]

  @@index([userId])
  @@index([parentId])
}

model ObjectiveAction {
  id          String       @id @default(cuid())
  objectiveId String
  siteId      String?
  type        ActionType
  status      ActionStatus @default(TODO)
  title       String
  detail      String?      // the evidence: numbers that justify the action
  query       String?
  url         String?
  priority    Int          @default(50) // 0..100, higher first
  source      String       @default("manual") // "manual" or "rule:<name>"
  fingerprint String?      // stable key for rule-generated actions (dedup)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  doneAt      DateTime?

  objective   Objective    @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  site        Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@unique([objectiveId, fingerprint])
  @@index([objectiveId, status])
}

enum ObjectiveStatus {
  ACTIVE
  PAUSED
  DONE
}

enum ActionType {
  CONTENT_NEW      // write a new page / article
  CONTENT_UPDATE   // strengthen or rewrite an existing page
  TERMINOLOGY      // install the defended term on a page that ranks for a rival term
  INTERNAL_LINK    // link between two of the user's sites or pages
  BACKLINK         // outreach for an external link
  WIKIPEDIA        // Wikipedia / Wikidata work, always manual
  PRESS            // tribune, interview, coverage in a target medium
  PROFILE          // Google Business Profile, directories, social profiles, entity markup
  TECHNICAL        // crawl / vitals fix
  OTHER
}

enum ActionStatus {
  TODO
  IN_PROGRESS
  DONE
  DISMISSED
}
